{
  "name": "Alopex SQL Parser (Nim)",
  "image": "nimlang/nim:2.2-alpine-regular",
  "customizations": {
    "vscode": {
      "extensions": [
        "nimsaem.nimvscode",
        "saem.vscode-nim"
      ]
    }
  },
  "postCreateCommand": "nimble install -y npeg",
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace,type=bind"
  ]
}
