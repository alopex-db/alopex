#!/bin/bash
# pre-commit hook for alopex repository
# Runs fmt check, clippy, and optional cross-architecture checks
#
# Setup: git config core.hooksPath .githooks
# Or run: ./scripts/setup-hooks.sh
#
# Environment variables:
#   ALOPEX_CROSS_CHECK=1  - Enable cross-compilation checks (requires toolchain)
#   ALOPEX_SKIP_CLIPPY=1  - Skip clippy (for faster commits)
#
# Cross-compilation requires C cross-compilers:
#   - aarch64-apple-darwin: macOS cross-compiler or osxcross
#   - aarch64-unknown-linux-gnu: aarch64-linux-gnu-gcc
#   - x86_64-pc-windows-msvc: cargo-xwin (cargo install cargo-xwin)
#       + rustup target add x86_64-pc-windows-msvc

set -e

echo "=== Pre-commit checks ==="

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Check internet connectivity via Discord API
echo -e "${YELLOW}Checking internet connectivity...${NC}"
if ! curl -s --connect-timeout 5 --max-time 10 -o /dev/null -w "%{http_code}" "https://discord.com/api/v10/gateway" | grep -q "^[23]"; then
    echo -e "${RED}Error: インターネットに接続できません${NC}"
    echo -e "${RED}Discord API (https://discord.com/api/v10/gateway) へのアクセスに失敗しました${NC}"
    echo ""
    echo "ネットワーク接続を確認してから再度コミットしてください"
    echo -e "${RED}警告: --no-verify オプションの使用は禁止されています${NC}"
    exit 1
fi
echo -e "${GREEN}Internet connectivity OK${NC}"
echo ""

# Check if we're in the repository root
if [ ! -f "Cargo.toml" ]; then
    echo -e "${RED}Error: Not in repository root${NC}"
    exit 1
fi

echo -e "${YELLOW}Running cargo fmt check...${NC}"
if ! cargo fmt --all -- --check; then
    echo -e "${RED}Format check failed!${NC}"
    echo "Run 'cargo fmt --all' to fix formatting issues"
    exit 1
fi
echo -e "${GREEN}Format check passed${NC}"

if [ "${ALOPEX_SKIP_CLIPPY:-0}" != "1" ]; then
    echo ""
    # CI は dtolnay/rust-toolchain@stable を使うため、stable ツールチェーンが
    # あれば stable で clippy を実行して CI とバージョンを揃える。stable 固有の
    # lint（Rust 1.96 の result_large_err / noop_waker 等）を push 前に検知する。
    CLIPPY_TOOLCHAIN=""
    if rustup toolchain list 2>/dev/null | grep -q "^stable-"; then
        CLIPPY_TOOLCHAIN="+stable"
    fi
    echo -e "${YELLOW}Running cargo ${CLIPPY_TOOLCHAIN:-default} clippy...${NC}"
    if ! make lane-ci-clippy CLIPPY_TOOLCHAIN="${CLIPPY_TOOLCHAIN}"; then
        echo -e "${RED}Clippy check failed!${NC}"
        echo "Fix the warnings above before committing"
        exit 1
    fi
    echo -e "${GREEN}Clippy check passed${NC}"
fi

# Network-stack duplicate-dependency check (only when Cargo.lock is staged).
# v0.7.1 のリリース障害(object_store の reqwest ^0.13 要求と alopex-cli の
# reqwest 0.12 指定が非互換で、hyper/rustls/tokio 系ネットワークスタックが
# 丸ごと2重に解決され、target/ が112GBに膨張して GitHub Actions ランナー
# (~14GB)でディスク枯渇)は、コミット前にこのチェックを一度でも回して
# いれば検知できていた。GitHub の CI に到達する前にローカルで止める。
#
# `cargo tree --duplicates` は巨大ワークスペースでは常時大量にヒットする
# (bevy/axum/itertools 等の既存重複は正常な状態でノイズが多い)ため、
# 全件は見ない。今回痛みが大きかった「重量級ネットワークスタックの丸ごと
# 重複」に絞って検知する。
if git diff --cached --name-only | grep -q '^Cargo\.lock$'; then
    echo ""
    echo -e "${YELLOW}Checking for duplicate network-stack dependencies (Cargo.lock changed)...${NC}"
    NETWORK_DUPS="$(cargo tree --duplicates 2>/dev/null | grep -E '^(reqwest|hyper|hyper-util|tokio-rustls|rustls|rustls-webpki|tower|tower-http|h2|tonic|axum|axum-server) v' || true)"
    if [ -n "$NETWORK_DUPS" ]; then
        echo -e "${RED}Duplicate network-stack dependency versions detected:${NC}"
        echo "$NETWORK_DUPS"
        echo ""
        echo -e "${RED}A network-stack crate is pulled in at two incompatible major${NC}"
        echo -e "${RED}versions, duplicating hyper/rustls/tokio's entire sub-tree${NC}"
        echo -e "${RED}(this is exactly what caused the v0.7.1 release CI to run${NC}"
        echo -e "${RED}out of disk space).${NC}"
        echo ""
        echo "Check with: cargo tree -i <crate-name>"
        echo "Align the version constraint with whichever dependent forces the"
        echo "newer major (usually visible directly in the output above)."
        exit 1
    fi
    echo -e "${GREEN}No duplicate network-stack dependencies${NC}"
fi

# Cross-architecture checks (optional, requires full toolchain)
if [ "${ALOPEX_CROSS_CHECK:-0}" = "1" ]; then
    echo ""
    echo -e "${CYAN}Running cross-architecture checks...${NC}"

    CROSS_TARGETS=(
        "aarch64-apple-darwin"
        "x86_64-apple-darwin"
        "aarch64-unknown-linux-gnu"
    )

    installed_targets=$(rustup target list --installed 2>/dev/null || echo "")
    cross_check_failed=0

    for target in "${CROSS_TARGETS[@]}"; do
        if echo "$installed_targets" | grep -q "^${target}$"; then
            echo -e "${YELLOW}  Checking ${target}...${NC}"
            if ! cargo check --target "$target" --all-features 2>&1; then
                echo -e "${RED}  Cross-check failed for ${target}!${NC}"
                cross_check_failed=1
            else
                echo -e "${GREEN}  ${target} OK${NC}"
            fi
        else
            echo -e "${YELLOW}  Skipping ${target} (not installed)${NC}"
        fi
    done

    # Windows (x86_64-pc-windows-msvc) は cargo-xwin で MSVC ツールチェーンを
    # Linux 上に用意してフロントエンドコンパイルを検証する。build.rs の
    # `cargo:rustc-link-lib` ディレクティブ構文や `#[link]` 属性など
    # Windows 専用コードの構文・型エラーを push 前に検知する。
    if echo "$installed_targets" | grep -q "^x86_64-pc-windows-msvc$"; then
        if command -v cargo-xwin >/dev/null 2>&1; then
            echo -e "${YELLOW}  Checking x86_64-pc-windows-msvc (cargo-xwin)...${NC}"
            if ! cargo xwin check --target x86_64-pc-windows-msvc --all-features 2>&1; then
                echo -e "${RED}  Cross-check failed for x86_64-pc-windows-msvc!${NC}"
                cross_check_failed=1
            else
                echo -e "${GREEN}  x86_64-pc-windows-msvc OK${NC}"
            fi
        else
            echo -e "${YELLOW}  Skipping x86_64-pc-windows-msvc (cargo-xwin not installed: cargo install cargo-xwin)${NC}"
        fi
    else
        echo -e "${YELLOW}  Skipping x86_64-pc-windows-msvc (target not installed: rustup target add x86_64-pc-windows-msvc)${NC}"
    fi

    if [ $cross_check_failed -eq 1 ]; then
        echo -e "${RED}Cross-architecture check failed!${NC}"
        exit 1
    fi
else
    echo ""
    echo -e "${CYAN}Cross-arch checks skipped (set ALOPEX_CROSS_CHECK=1 to enable)${NC}"
fi

echo ""
echo -e "${GREEN}=== All pre-commit checks passed ===${NC}"
