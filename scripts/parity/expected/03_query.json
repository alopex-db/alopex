          { "id": 5, "name": "erin" }
        ]
      }
    },
    {
      "index": 6,
      "sql": "SELECT id, score * 2.0 AS double_score FROM users WHERE score IS NOT NULL ORDER BY id",
      "expected": {
        "type": "query",
        "columns": ["id", "double_score"],
        "rows": [
          { "id": 1, "double_score": 165.0 },
          { "id": 2, "double_score": 148.5 },
          { "id": 3, "double_score": 180.0 },
          { "id": 5, "double_score": 131.0 },
          { "id": 6, "double_score": 143.5 }
        ]
      }
    },
    {
