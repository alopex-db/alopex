{
  "corpus": "03_query.sql",
  "format": {
    "success": "DDL 文の成功 (結果セットなし)",
    "rows_affected": "DML 文の成功 (count = 影響行数)",
    "query": "columns = 出力列名の順序付き配列 / rows = 列名をキーとするオブジェクトの配列 / 浮動小数点は有効数字 9 桁へ丸め / NULL は JSON null"
  },
  "statements": [
    {
      "index": 1,
      "sql": "SELECT * FROM users ORDER BY id",
      "expected": {
        "type": "query",
        "columns": ["id", "name", "region", "age", "score", "active"],
        "rows": [
          { "id": 1, "name": "alice", "region": "east", "age": 30, "score": 82.5, "active": true },
          { "id": 2, "name": "bob", "region": "west", "age": 25, "score": 74.25, "active": true },
          { "id": 3, "name": "carol", "region": "east", "age": 35, "score": 90.0, "active": false },
          { "id": 4, "name": "dave", "region": "west", "age": 29, "score": null, "active": false },
          { "id": 5, "name": "erin", "region": "north", "age": 22, "score": 65.5, "active": false },
          { "id": 6, "name": "frank", "region": "east", "age": null, "score": 71.75, "active": true }
        ]
      }
    },
    {
      "index": 2,
      "sql": "SELECT id, name AS user_name, score FROM users WHERE score >= 70.0 AND active = TRUE ORDER BY score DESC",
      "expected": {
        "type": "query",
        "columns": ["id", "user_name", "score"],
        "rows": [
          { "id": 1, "user_name": "alice", "score": 82.5 },
          { "id": 2, "user_name": "bob", "score": 74.25 },
          { "id": 6, "user_name": "frank", "score": 71.75 }
        ]
      }
    },
    {
      "index": 3,
      "sql": "SELECT id, name FROM users WHERE region = 'east' OR (age IS NOT NULL AND age < 26) ORDER BY id",
      "expected": {
        "type": "query",
        "columns": ["id", "name"],
        "rows": [
          { "id": 1, "name": "alice" },
          { "id": 2, "name": "bob" },
          { "id": 3, "name": "carol" },
          { "id": 5, "name": "erin" },
          { "id": 6, "name": "frank" }
        ]
      }
    },
    {
      "index": 4,
      "sql": "SELECT id, name FROM users WHERE score IS NULL ORDER BY id",
      "expected": {
        "type": "query",
        "columns": ["id", "name"],
        "rows": [ { "id": 4, "name": "dave" } ]
      }
    },
    {
      "index": 5,
      "sql": "SELECT id, name FROM users WHERE age IS NOT NULL ORDER BY id",
      "expected": {
        "type": "query",
        "columns": ["id", "name"],
        "rows": [
          { "id": 1, "name": "alice" },
          { "id": 2, "name": "bob" },
          { "id": 3, "name": "carol" },
