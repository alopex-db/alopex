  "invariants": [
    "one-owner-per-observed-signature",
    "no-version-gate-invokes-another-version-gate",
    "final-gate-is-status-only",
    "expensive-and-performance-work-is-not-a-merge-gate-responsibility",
    "target-and-cache-lifecycle-is-explicit-per-owner"
