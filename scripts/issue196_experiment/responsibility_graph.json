        "evidence": ".github/workflows/ci.yml -> crates/alopex-tools/v08/verify-v08-surfaces.sh"
      }
    ]
  },
  "target_graph": {
    "description": "Each verification responsibility has one owner; the final gate joins owner statuses only.",
    "final_gate_needs": [
      "current-quality",
      "current-implementation",
      "historical-compatibility",
      "delivery-contract",
      "exhaustive-performance"
    ],
    "final_gate_commands": []
