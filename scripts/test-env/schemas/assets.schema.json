{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "platform",
    "source_commit",
    "harness_commit",
    "expanded_limit_bytes",
    "files"
  ],
  "properties": {
    "schema": {
      "const": "alopex.test-env-assets/v1"
    },
    "platform": {
      "type": "string",
      "pattern": "^linux/"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "harness_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "expanded_limit_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "role",
          "size",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "server",
              "wheel",
              "receipt",
              "library",
              "harness"
            ]
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
