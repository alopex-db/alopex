{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "status",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "alopex.test-env-public/v1"
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "image_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "assets_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "harness_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "error_code"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[EFSRP][0-9]{2}$"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not_run"
            ]
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "controller_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "controller_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    }
  }
}
